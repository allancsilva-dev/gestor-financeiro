POSTGRES_DB=dbnexos-gestor-financeiro
POSTGRES_HOST=dbnexos-gestor-financeiro
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://dbnexos-gestor-financeiro:5432/dbnexos-gestor-financeiro
DB_USERNAME=dbnexos_gestor
DB_PASSWORD=change-owner-password

JWT_SECRET=change-long-random-secret-at-least-32-bytes

API_PORT=8080
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=https://financas.nexostech.com.br

COOKIE_SECURE=true
APP_DOCS_PUBLIC=false
BACKUP_RETENTION_DAYS=7

# Microsoft 365 / Exchange Online (SMTP AUTH + STARTTLS)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=allan@nexostech.com.br
SMTP_PASSWORD=change-mailbox-password
MAIL_FROM=contato@nexostech.com.br

# Assistente financeiro (ADR-0017). Fail-closed: canal desligado nao registra controller e a
# rota devolve 404. O app le /api/v1/capacidades em runtime, entao ligar aqui basta - nao
# precisa publicar APK/IPA novo.
# Pre-requisito: banco em V65 ou superior. Abaixo da V57 as tabelas assistant_* nao existem.
ASSISTANT_TEXT_ENABLED=true
ASSISTANT_AUDIO_ENABLED=false
# NAO ligue ASSISTANT_EXTERNAL_ENABLED sem billing confirmado, politica de dados aceita,
# teto de custo e as DUAS chaves (GEMINI_API_KEY e OPENAI_API_KEY): no profile vps o
# AssistantExternalConfigurationGuard derruba o boot da API. Desligado, o assistente roda
# com o parser deterministico e nao custa nada.
